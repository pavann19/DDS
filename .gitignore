# Trained model artifacts (regenerate via model_pipeline.py)
*.pkl
anomaly_feature_bounds.json
feature_info.json
metrics.json

# optimal_features.json is the ONE exception: it is genetic_optimizer.py's
# exhaustive-search result, which is not reproducible run-to-run (tie
# breaks), and model_pipeline.py + the inference tests depend on the exact
# subset. So it is committed as pinned config -- small, diffable, reviewed
# on change -- and CI regenerates every other artifact from it.
!optimal_features.json

# Processed/derived data (regenerate via data_prep.py)
processed_telemetry.csv

