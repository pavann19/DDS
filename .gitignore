# Python
venv/
# Isolated Python 3.12 environment for MetaDrive (P5-3a) -- MetaDrive requires
# Python <3.13, incompatible with the main venv/'s 3.13. Entirely separate
# from the app; large binary packages, never committed.
venv_metadrive/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/

# Runtime / generated at runtime, not source
dds_telemetry.db
dds_telemetry.db-shm
dds_telemetry.db-wal
*.log

# Env
.env
!.env.example

# Evidence/context-pack working files are tracked (small, source-of-truth for the verification protocol)

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node (frontend/.gitignore already covers node_modules/.next; this is a backstop
# in case anything is ever run from the repo root)
node_modules/
