# Copy to .env and adjust as needed. All values below are the defaults already
# baked into app/core/config.py — this file exists to document what's overridable,
# not because the app requires it to boot.

PROJECT_NAME="DDS Autopilot API v4.0"

# SQLite by default (dds_telemetry.db in the project root, gitignored — it's
# runtime state, not source). Override for a different DB backend.
# DATABASE_URL=sqlite+aiosqlite:///./dds_telemetry.db

# JSON array of allowed frontend origins for CORS.
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

LOG_LEVEL=INFO

# Frontend (frontend/.env.local, not this file): override the WebSocket URL the
# dashboard connects to if the backend isn't at the same host on port 8000.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
